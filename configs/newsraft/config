# General
set scrolloff 2
# set menu-item-sorting time-desc

# Notification Settings
notification-command "notify-send -t 5000 'Newsraft' 'Refreshed and found %q new entries.'"

list-entry-date-format         "%b-%d %H:%M"
menu-item-entry-format         "%u| %d | %o"
menu-explore-item-entry-format "%u| %d | %-15T | %o"

bind q quit
bind Q quit-hard

bind tab toggle-explore-mode
bind e   toggle-explore-mode

# bind o mark-read; exec nohup firefox "%l" >/dev/null 2>&1 &
bind o open-in-browser; mark-read

bind d mark-read; jump-to-next
bind D mark-read-all
bind ^D mark-unread; jump-to-next

bind n jump-to-next-unread
bind N jump-to-prev-unread
bind p jump-to-next-important
bind P jump-to-prev-important

bind t sort-by-time
bind u sort-by-unread
bind i sort-by-important
bind a sort-by-alphabet

bind f mark-important; jump-to-next
bind F mark-unimportant; jump-to-next

bind ? exec man newsraft

color-status               default default
color-status-info          cyan    default
color-status-fail          red     default
color-list-item            default default
color-list-item-unread     yellow  default
color-list-item-important  magenta default
color-list-feed            default default
color-list-feed-unread     yellow  default
color-list-feed-failed     red     default
color-list-section         default default
color-list-section-unread  yellow  default
color-list-section-failed  red     default